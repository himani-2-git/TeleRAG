# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# LLM Endpoint Configuration
# Documented Default: Fully local with Ollama (no API key needed)
# Run `ollama list` to inspect local models (e.g. qwen2:7b)
LLM_BASE_URL=http://localhost:11434/v1
OPENROUTER_MODEL=qwen2:7b

# Alternative: OpenRouter (cloud API, requires API key)
# To use OpenRouter:
# 1. Set OPENROUTER_API_KEY=your_openrouter_api_key_here
# 2. Set LLM_BASE_URL=https://openrouter.ai/api/v1
# 3. Pick a model marked free from https://openrouter.ai/models (free model names change often) and set OPENROUTER_MODEL
OPENROUTER_API_KEY=

# Optional Configuration (defaults provided)
MAX_FILE_SIZE_MB=20
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
EMBEDDING_MODEL=all-MiniLM-L6-v2
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.3
RETRIEVAL_MODE=hybrid
MAX_RETRIES=3
RETRY_DELAY=1.0
DATABASE_PATH=data/documents.db
EMBEDDINGS_PATH=data/embeddings
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log