# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# LLM Endpoint Configuration
# Default: Fully local with Ollama (no API key needed)
# Run `ollama list` to inspect local models (e.g. qwen2.5:3b)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:3b

# Optional: Hosted LLM endpoint (requires API key)
# For remote OpenAI-compatible providers (e.g. OpenRouter, Groq, Google AI Studio):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=your_api_key_here
# LLM_MODEL=your_model_name
LLM_API_KEY=

# Optional Configuration (defaults provided)
MAX_FILE_SIZE_MB=20
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
EMBEDDING_MODEL=all-MiniLM-L6-v2
TOP_K_RESULTS=2
SIMILARITY_THRESHOLD=0.3
RETRIEVAL_MODE=hybrid
LLM_MAX_TOKENS=300
MAX_RETRIES=3
RETRY_DELAY=1.0
DATABASE_PATH=data/documents.db
EMBEDDINGS_PATH=data/embeddings
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# Vector Backend & Storage
# Options: numpy (default, zero extra dependencies), chroma (requires pip install -r requirements/chroma.txt)
VECTOR_BACKEND=numpy
CHROMA_PATH=data/chroma

# Pipeline Orchestrator
# Options: plain (default, direct execution), langgraph (requires pip install -r requirements/graph.txt)
ORCHESTRATOR=plain

# Prompt & Grounding Configuration
PROMPT_VERSION=v1
GROUNDING_THRESHOLD=0.45
GROUNDING_ENFORCE=false
GROUNDING_MIN_COVERAGE=0.5
